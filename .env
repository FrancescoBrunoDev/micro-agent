# ═══════════════════════════════════════════════════════════════════════
# PI WEB — Docker environment variables
# Used by docker-compose.yml. All config is via env vars (Coolify-friendly).
# ═══════════════════════════════════════════════════════════════════════

# ── LLM Provider (used by Pi inside the container) ─────────────────────
# The OpenAI-compatible endpoint where your local LLM runs.
# On Coolify: set to another service name on the same network, e.g. "http://ollama:11434/v1"
LLM_BASE_URL=http://omarchy:1298/v1

# API key (optional — many local LLMs don't need one)
OPENAI_API_KEY=not-needed

# ── Model Configuration ─────────────────────────────────────────────────
# Used to generate Pi's models.json on first container start.
PI_PROVIDER=openai
PI_MODEL_NAME=qwen2.5-coder:32b

# ── PI WEB Settings ─────────────────────────────────────────────────────
# Bind address and port for the web UI.
# On Coolify: set PI_WEB_BIND_ADDR=0.0.0.0 to expose via a Coolify service.
PI_WEB_BIND_ADDR=127.0.0.1
PI_WEB_PORT=8505

# ── Volume Configuration (for Coolify) ──────────────────────────────────
# Named volume for persistent data (sessions, workspaces, Pi config).
# Change the name if you need multiple instances on the same host.
PI_WEB_VOLUME_NAME=pi-web-data

# Container name prefix (useful if running multiple instances)
PI_WEB_CONTAINER_PREFIX=pi-web
