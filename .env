# ═══════════════════════════════════════════════════════════════════════
# PI WEB — Docker environment variables
# All config is via env vars (Coolify-friendly). No external file mounts.
# ═══════════════════════════════════════════════════════════════════════

# ── LLM Provider (llama.cpp / OpenAI-compatible) ─────────────────────────
# The endpoint where your local LLM runs (e.g. llama.cpp server).
# On Coolify: set to another service name on the same network.
LLM_BASE_URL=http://omarchy:1298/v1

# API key for the LLM (optional — most local LLMs don't need one).
# NOTE: this is used ONLY inside models.json (via the entrypoint), NOT as a
# container env var. Passing OPENAI_API_KEY globally makes Pi's built-in
# openai provider "configured" and shows its gpt-* models in the UI.
LLM_API_KEY=not-needed

# Provider name shown in the pi-web UI (default: llamacpp).
# Using a non-"openai" name keeps Pi's built-in OpenAI catalog separate.
# PI_PROVIDER=llamacpp
# Restrict the model picker to a provider pattern (default: <provider>/*).
# PI_MODEL_PATTERN=llamacpp/*

# ── PI WEB Settings ──────────────────────────────────────────────────────
# Bind address and host port for the web UI.
# 0.0.0.0 = accessible from outside the container (LAN/Coolify).
PI_WEB_BIND_ADDR=0.0.0.0
PI_WEB_HOST_PORT=8505

# ── GitHub CLI (gh) ─────────────────────────────────────────────────────
# Optional: token so `gh` / `git` work inside the container.
# Create one at https://github.com/settings/tokens (repo, workflow scopes)
# or use: gh auth login --with-token
GH_TOKEN=
GH_USER_NAME=
GH_USER_EMAIL=

