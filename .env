# ═══════════════════════════════════════════════════════════════════════
# micro-agent — Docker environment variables
# Copy to .env, uncomment and set values as needed.
# Used automatically by docker-compose.yml.
# ═══════════════════════════════════════════════════════════════════════

# ── LLM Provider ─────────────────────────────────────────────────────
# The OpenAI-compatible endpoint where your local LLM runs.
# Examples:
#   http://host.docker.internal:8080/v1   (same host as docker)
#   http://192.168.1.100:8080/v1         (remote machine)
#   http://ollama:11434/v1               (Ollama in docker compose)
LLM_BASE_URL=http://omarchy:1298/v1

# API key for the LLM endpoint (optional — many local LLMs don't need one).
# OPENAI_API_KEY=not-needed

# Which provider to use (default: openai).
# MICRO_AGENT_PROVIDER=openai

# Model name to use.
# Examples: step-3.7-flash, qwen2.5-coder:32b, llama3.1:70b, gpt-4o
MICRO_AGENT_MODEL=unsloth-Qwen3.6-35B-A3B-MTP-GGUF

# ── Gateway Server ───────────────────────────────────────────────────
# Host and port the gateway binds to (inside the container).
# MICRO_AGENT_HOST=0.0.0.0
# MICRO_AGENT_PORT=8765

# Path to config file inside the container.
# MICRO_AGENT_CONFIG=/app/config.yaml

# Memory storage path.
# MICRO_AGENT_MEMORY_PATH=/data/memory

# Gateway log level (debug, info, warning, error).
# MICRO_AGENT_LOG_LEVEL=info

# ── Telegram Bot (optional) ──────────────────────────────────────────
# Bot token from @BotFather on Telegram.
# TELEGRAM_BOT_TOKEN=

# Secret token for Telegram webhook verification.
# TELEGRAM_WEBHOOK_SECRET=

# ── Custom Providers (optional) ──────────────────────────────────────
# If you want Pi to use a provider other than openai, set:
# MICRO_AGENT_PROVIDER=ollama

# Extra arguments passed to `pi --mode rpc`.
# Example: --base-url http://ollama:11434/v1
# PI_EXTRA_ARGS=--base-url http://ollama:11434/v1

# ── Pi Agent Settings ───────────────────────────────────────────────
# Disable Pi's update check (no network call on startup).
PI_DISABLE_UPDATE_CHECK=1
PAGER=cat
EDITOR=cat
