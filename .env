# ═══════════════════════════════════════════════════════════════════════
# micro-agent / PI WEB — Docker environment variables
# Used automatically by docker-compose.yml.
# ═══════════════════════════════════════════════════════════════════════

# ── LLM Provider (used by Pi inside the pi-web container) ──────────────
# The OpenAI-compatible endpoint where your local LLM runs.
LLM_BASE_URL=http://omarchy:1298/v1

# API key for the LLM endpoint (optional — many local LLMs don't need one).
OPENAI_API_KEY=not-needed

# ── PI WEB (browser UI for Pi sessions) ────────────────────────────────
# Bind address and port for pi-web's web interface.
# Defaults to 127.0.0.1:8505 (loopback only — do not expose publicly without auth).
PI_WEB_BIND_ADDR=127.0.0.1
PI_WEB_PORT=8505

# ── Pi Agent Settings ──────────────────────────────────────────────────
PI_DISABLE_UPDATE_CHECK=1
PAGER=cat
EDITOR=cat

# ── Telegram Bot (only used if you also run the micro-agent gateway) ───
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_ALLOWED_CHAT_IDS=...
