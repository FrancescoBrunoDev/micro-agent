# ── LLM: llama.cpp (OpenAI-compatible endpoint) ───────────────────────────
# host.docker.internal = llama.cpp runs on the docker host. On Coolify use the
# service hostname of the llama.cpp container. Models are auto-discovered
# from /v1/models at startup (pi picks once, then stays).
LLAMACPP_BASE_URL=http://host.docker.internal:8080/v1
# API key used by opencode-go for this endpoint.
OPENCODE_GO_API_KEY=not-needed

# ── kDrive (Infomaniak) via WebDAV ────────────────────────────────────────
# App password: https://account.infomaniak.com → Security → App passwords.
# Endpoint: https://<kDriveId>.connect.kdrive.infomaniak.com (see kDrive
# settings → Remote access / WebDAV).
KDRIVE_URL=
KDRIVE_USER=your@email
KDRIVE_PASS=
# Vault path relative to the kDrive root.
KDRIVE_VAULT_PATH=Obsidian/Francesco_Vault
# Bisync loop interval in seconds.
KDRIVE_SYNC_INTERVAL=60

# ── GitHub CLI ──────────────────────────────────────────────────────
# Fine-grained PAT: gh uses GH_TOKEN as its login automatically.
GH_TOKEN=
GH_USER_NAME=
GH_USER_EMAIL=

# ── SSH access ──────────────────────────────────────────────────────
# Public key(s) allowed to log in as root (contents of id_ed25519.pub,
# can hold multiple lines). Empty = sshd disabled.
SSH_PUBLIC_KEY=
# Host port mapped to the container's sshd (22).
SSH_PORT=2222
