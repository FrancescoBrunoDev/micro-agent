# ═══════════════════════════════════════════════════════════════════════
# PI WEB — Environment variable template
# Copy to .env and customize for your setup.
# ═══════════════════════════════════════════════════════════════════════

# LLM endpoint (OpenAI-compatible)
LLM_BASE_URL=http://your-llm:8080/v1

# API key (optional)
OPENAI_API_KEY=not-needed

# Model config
PI_PROVIDER=openai
PI_MODEL_NAME=qwen2.5-coder:32b

# Web UI settings
PI_WEB_BIND_ADDR=0.0.0.0     # Use 0.0.0.0 for Coolify
PI_WEB_PORT=8505

# Volume name (change if running multiple instances)
PI_WEB_VOLUME_NAME=pi-web-data
