# ═══════════════════════════════════════════════════════════════════════
# PI WEB — Environment variable template for Coolify
# Copy to .env and customize, or set these directly in Coolify dashboard.
# ═══════════════════════════════════════════════════════════════════════

# LLM endpoint (OpenAI-compatible)
LLM_BASE_URL=http://your-llm:8080/v1

# API key (optional)
OPENAI_API_KEY=not-needed

# Web UI settings
PI_WEB_BIND_ADDR=0.0.0.0     # Use 0.0.0.0 for Coolify
PI_WEB_HOST_PORT=8505
