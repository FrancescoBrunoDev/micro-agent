# ═══════════════════════════════════════════════════════════════════════
# PI WEB — Environment variable template for Coolify
# Copy to .env and customize, or set these directly in Coolify dashboard.
# ═══════════════════════════════════════════════════════════════════════

# LLM endpoint (OpenAI-compatible, e.g. llama.cpp)
LLM_BASE_URL=http://your-llm:8080/v1

# API key (optional)
OPENAI_API_KEY=not-needed

# Provider name shown in pi-web UI (default: llamacpp)
# PI_PROVIDER=llamacpp

# Web UI settings
PI_WEB_BIND_ADDR=0.0.0.0     # 0.0.0.0 = accessible from outside (Coolify)
PI_WEB_HOST_PORT=8505

# GitHub CLI token (optional) — repo + workflow scopes
# GH_TOKEN=ghp_xxx
# GH_USER_NAME=Your Name
# GH_USER_EMAIL=you@example.com
