# ── LLM (OpenAI-compatible endpoint) ──────────────────────────────────────
# host.docker.internal = the LLM runs on the docker host. On Coolify use the
# service hostname of the LLM container (e.g. http://my-llm:8080/v1).
LLM_BASE_URL=http://host.docker.internal:8080/v1
LLM_API_KEY=not-needed
# Provider name inside pi (distinct from "openai" keeps pi's built-in
# catalog out of the way). Model must be served by the endpoint above.
PI_PROVIDER=local
# Model id. Set it explicitly for a deterministic start; if empty the
# entrypoint takes the first model returned by /v1/models.
PI_MODEL_NAME=

# ── kDrive (Infomaniak) via WebDAV ────────────────────────────────────────
# App password: https://account.infomaniak.com → Security → App passwords.
# Endpoint: https://<kDriveId>.connect.kdrive.infomaniak.com (see kDrive
# settings → Remote access / WebDAV).
KDRIVE_URL=
KDRIVE_USER=your@email
KDRIVE_PASS=
# Vault path relative to the kDrive root.
KDRIVE_VAULT_PATH=Obsidian/Francesco_Vault
# Bisync loop interval in seconds.
KDRIVE_SYNC_INTERVAL=60
