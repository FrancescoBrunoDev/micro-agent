# ═══════════════════════════════════════════════════════════════════════
# PI WEB — Environment variable template for Coolify
# Copy to .env and customize, or set these directly in Coolify dashboard.
# ═══════════════════════════════════════════════════════════════════════

# LLM endpoint (OpenAI-compatible, e.g. llama.cpp)
LLM_BASE_URL=http://your-llm:8080/v1

# API key for the LLM (optional — most local LLMs don't need one).
# Used inside models.json only — do NOT set OPENAI_API_KEY as a global env,
# it makes Pi's built-in openai provider "configured" and shows gpt-* models.
LLM_API_KEY=not-needed

# Provider name shown in pi-web UI (default: llamacpp)
# PI_PROVIDER=llamacpp

# Web UI settings
PI_WEB_BIND_ADDR=0.0.0.0     # 0.0.0.0 = accessible from outside (Coolify)
PI_WEB_HOST_PORT=8505
# PI_WEB_HOSTNAME=pi-web          # container hostname on the docker network
# PI_WEB_NETWORK=pi-web-net       # docker network name
# PI_WEB_NETWORK_EXTERNAL=false   # true = join existing network (Coolify: set to coolify + true)
# On Coolify, services on the same network reach pi-web at http://pi-web:8504

# GitHub CLI token (optional) — repo + workflow scopes
# GH_TOKEN=ghp_xxx
# GH_USER_NAME=Your Name
# GH_USER_EMAIL=you@example.com

# KDrive sync folder on the host (bind-mounted to /data/kdrive in container).
# Leave empty on Coolify; use a volume / persistent storage there instead.
# KDRIVE_PATH=/home/you/kdrive

# KDrive (Infomaniak) via WebDAV + rclone — optional.
# URL = https://<kDriveId>.connect.kdrive.infomaniak.com
# PASS = app password from https://account.infomaniak.com → Security
# KDRIVE_URL=
# KDRIVE_USER=you@example.com
# KDRIVE_PASS=
# KDRIVE_MOUNT=/data/kdrive
